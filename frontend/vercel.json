{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://publishpdf.vercel.app/api/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://publishpdf.vercel.app/api/:path*"
    },
    {
      "source": "/sites/:path*/",
      "destination": "https://publishpdf.vercel.app/sites/:path*/"
    },
    {
      "source": "/sites/:path*",
      "destination": "https://publishpdf.vercel.app/sites/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
