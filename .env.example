# PublishPDF environment template. Copy to .env and fill in.
# Values marked PLACEHOLDER are unconfirmed decisions (see PLAN.md §5) — do not ship them as-is.

APP_ENV=development                       # development | production

# --- Database (PostgreSQL 16) --------------------------------------------------
# Owner role runs migrations. App role must NOT be superuser or table owner, so RLS applies.
DATABASE_OWNER_URL=postgresql+psycopg://publishpdf_owner:CHANGE_ME@localhost:5432/publishpdf
DATABASE_APP_URL=postgresql+psycopg://publishpdf_app:CHANGE_ME@localhost:5432/publishpdf

# --- Platform domains (PLAN.md D6/D7) --------------------------------------------
PLATFORM_DOMAIN=publishpdf.ai                           # PLACEHOLDER: "likely", confirm
PLATFORM_TARGET_HOSTNAME=edge.publishpdf.ai             # PLACEHOLDER: CNAME target clients point to
PREVIEW_URL_PATTERN={tenant_slug}.preview.publishpdf.ai # PLACEHOLDER: noindex preview hosts
VERIFY_PREFIX=publishpdf                                # PLACEHOLDER: TXT at _{prefix}.{subdomain}
DASHBOARD_BASE_URL=http://localhost:5173                # where magic links / invites point

# --- Auth ----------------------------------------------------------------------
APP_SECRET_KEY=                           # REQUIRED: `uv run python -m app.cli gen-secret`
SESSION_TTL_HOURS=12
MAGIC_LINK_TTL_MINUTES=15
INVITE_TTL_DAYS=7
TOTP_ISSUER=PublishPDF
TOTP_MAX_ATTEMPTS=5
COOKIE_SECURE=false                       # true in production (HTTPS)

# --- Email -----------------------------------------------------------------------
EMAIL_BACKEND=console                     # console (dev: logs links) | smtp
EMAIL_FROM=no-reply@example.invalid       # PLACEHOLDER
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Storage (PLAN.md D13: India region in production) ------------------------------
STORAGE_BACKEND=local                     # local | s3
STORAGE_LOCAL_ROOT=./.data/storage
S3_BUCKET=                                # PLACEHOLDER: private bucket
S3_REGION=                                # PLACEHOLDER: e.g. an India region, per D13
S3_ENDPOINT_URL=                          # set for MinIO / non-AWS S3

# --- Limits (PLAN.md D12: proposed, to confirm) ----------------------------------------
MAX_UPLOAD_MB=100
MAX_PAGES=600
OCR_CONFIDENCE_THRESHOLD=0.95

# --- Jobs --------------------------------------------------------------------------
JOB_MAX_ATTEMPTS=3
JOB_POLL_SECONDS=1.0

# --- Public tenant sites ------------------------------------------------------------
PUBLIC_SCHEME=https                        # dev: http
PUBLIC_PORT_SUFFIX=                        # dev: :8080 (public server port)
DISCLAIMER_DEFAULT_TEXT=                   # PLACEHOLDER (PLAN D11): text after legal review; publishing blocked while empty unless the tenant sets one

# --- Custom domains / TLS (PLAN D5) ------------------------------------------------------
TLS_MODE=caddy                             # caddy | off (development only)
EDGE_PROBE_ADDRESS=                        # PLACEHOLDER: host:port of the Caddy edge, used to confirm certificates
ACME_CA_DOMAINS=letsencrypt.org,pki.goog,sectigo.com   # CAA values that allow our issuer
INTERNAL_API_TOKEN=                        # shared secret for Caddy's on-demand TLS "ask" call

# --- LLM assist (PLAN D4) — off unless a tenant opts in ------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
